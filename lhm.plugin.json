  "tools": [
    {
      "name": "kynth_parse",
      "title": "Document parse",
      "description": "Any invoice, receipt, EOB, ERA, or COI — PDF or image — into structured, validated JSON. Costs credits from the account wallet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fileUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public URL to a PDF or image."
          },
          "text": {
            "type": "string",
            "description": "Raw text, if you already have it."
          },
          "fileBase64": {
            "type": "string",
            "description": "Base64-encoded file bytes (with fileMimeType)."
          },
          "fileMimeType": {
            "type": "string",
            "description": "MIME type for fileBase64, e.g. application/pdf."
          },
          "docType": {
            "type": "string",
            "description": "Optional hint, e.g. \"invoice\"."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
